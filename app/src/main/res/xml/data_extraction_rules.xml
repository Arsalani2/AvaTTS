<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules — گاوصندوق کلید از cloud-backup و device-transfer مستثنی است.
   ciphertext بدون KeyStore دستگاه مبدا قابل بازگشایی نیست (BUG-23).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ava_vault_secure_store_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ava_vault_secure_store_v1.xml" />
    </device-transfer>
</data-extraction-rules>
